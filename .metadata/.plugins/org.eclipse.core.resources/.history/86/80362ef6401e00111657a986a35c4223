int avg_wo_min_max(int16_t *data, uint8_t len) {
    if (len < 5 || len > 8) return 0;  // invalid input

    int16_t min = data[0];
    int16_t max = data[0];
    int16_t sum = data[0];  // use 32-bit int to avoid overflow

    for (uint8_t i = 1; i < len; i++) {
        if (data[i] < min) min = data[i];
        if (data[i] > max) max = data[i];
        sum += data[i];
    }

    // Remove min and max from the sum
    sum -= min;
    sum -= max;

    // Return integer average of remaining values
    return sum*0.33f;
}


