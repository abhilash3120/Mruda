//Fast sine calculation function

float sine_slow(float angle){
	angle *= 0.0174533f; //deg to rad
	return (32000.0f *sinf(angle));
}


float sine_1 (float angle)
  {
    int angle_int;
    angle=angle_mult*angle;
    angle_int=angle;
    return (sine_data[angle_int]);
  }

float sine(float angle)
{
    // assuming sine_data[] has 720 points for 0–360° (0.5° step)
    // i.e., one table entry per 0.5°
     angle *= angle_mult;  // convert degrees → 0.5° index scale


    int angle_int = (int)angle;
    float frac = angle - angle_int;          // fractional part
    int next_index = angle_int + 1;


    if (next_index >= Sine_table_size)
        next_index = 0;

    // linear interpolation
    float y0 = sine_data[angle_int];
    float y1 = sine_data[next_index];
    return y0 + frac * (y1 - y0);
}

float sine_t (float angle)
  {
    angle *= angle_mult;  // convert degrees → 0.5° index scale

    int angle_int = (int)angle;
    float frac = angle - angle_int;          // fractional part
    int next_index = angle_int + 1;

    if (next_index >= Sine_table_size)
        next_index = 0;

    // linear interpolation
    float y0 = sine_data_tanpura[angle_int];
    float y1 = sine_data_tanpura[next_index];
    return y0 + frac * (y1 - y0);
  }


