            // only temp to checkkk clip issyes
            int16_t current_sample = buff[i];

            // 1. Track Absolute Max Amplitude
            int16_t abs_sample = (current_sample < 0) ? -current_sample : current_sample;
            if (abs_sample > max_amp) max_amp = abs_sample;

            // 2. Track Max Derivative (Rate of Change)
            int16_t now_derivative = current_sample - old_amp;
            int16_t abs_derivative = (now_derivative < 0) ? -now_derivative : now_derivative;
            if (abs_derivative > max_derivative) max_derivative = abs_derivative;

            old_amp = current_sample;
            reset_counter++;
                if (reset_counter >= RESET_INTERVAL) {

