    HAL_GPIO_WritePin(S3_port, S3_pin, (ch >> 3) & 0x01);
}



float rand_float(void) {
	seed = 1664525 * seed + 1013904223;

	    // Map 31-bit int to float in [-1.0, 1.0]
	    int32_t signed_val = (int32_t)(seed >> 1); // 31-bit signed int
	    // Multiply by precomputed constant
	    return signed_val * 0.00000000093132257f; // ≈ 1 / (2^30 - 1)
}


int rand_int_16(void) {
    seed = 1664525 * seed + 1013904223;

    // Take lower 5 bits (0 to 31)
    int val = (int)(seed & 0x1F);  // 0 to 31
    return val - 16;                // -16 to 15
}

