void amp_setup(){

	float total_amp=0;

	for(int k=0;k<20;k++){
		amp[k+1]=preset[0][k];

	}


	//expo evelope
	for(int i=0;i<20;i++){
		amp[i+1]=amp[i+1]*powf(i+1,ST_expo);
	}

	//OE_dist=1.1;
	for(int i=1;i<11;i++){
	    amp[2*i] = amp[2*i] * OE_dist;     // Even harmonic gets boosted
	    amp[2*i-1]  = amp[2*i-1] / OE_dist;     // Odd harmonic gets reduced
	}


	//octave_mix=50;
	for(int i=0;i<19;i++){
		amp[i+1]=amp[i+1]+(octave_mix/100)*amp[i+2];
		amp[i+1]=amp[i+1]*(1.0f + cosf( 3.141592f* (i+1) / 20));
	}

	// normalising amplitudes
	for(int i=0;i<20;i++){
		total_amp=total_amp+amp[i+1];
	}

	for(int i=0;i<20;i++){
	    		amp[i+1]=amp[i+1]/total_amp;
	    	}

	for(int i=0;i<20;i++){
		temp_amp[i+1]=amp[i+1];
	}

}


// Assumes sin_table is allocated as sin_table[1801]
void Creat_sine_table(float* sin_table, uint8_t preset_type){
	//generate a base waveform that is combination of its harmonics


	//creating table
    for(int i=0;i<Sine_table_size;i++)
      {	float temp1;
      float step= 6.28318530718f/(float)(Sine_table_size);

