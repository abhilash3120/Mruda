void send_usb_midi_packet(uint8_t cin, uint8_t status, uint8_t data1, uint8_t data2) {
    uint8_t packet[4];
    packet[0] = (0x0 << 4) | (cin & 0x0F);  // Cable #0 + CIN
    packet[1] = status;
    packet[2] = data1;
    packet[3] = data2;
    //USBD_HID_SendReport(&hUsbDeviceFS, packet, 4);
}

void midi_note_on(uint8_t note, uint8_t velocity) {
    send_usb_midi_packet(0x9, 0x90, note, velocity);  // CIN 0x9 = Note On
}


void midi_note_off(uint8_t note, uint8_t velocity) {
    send_usb_midi_packet(0x8, 0x80, note, velocity);  // CIN 0x8 = Note Off
}

void midi_pitch_bend(float semitones) {
    if (semitones > 12.0f) semitones = 12.0f;
    if (semitones < -12.0f) semitones = -12.0f;

    int32_t bend = 8192 + (int32_t)((semitones / 12.0f) * 8192.0f);
    if (bend < 0) bend = 0;
    if (bend > 16383) bend = 16383;

    uint8_t lsb = bend & 0x7F;
    uint8_t msb = (bend >> 7) & 0x7F;

    send_usb_midi_packet(0xE, 0xE0, lsb, msb);  // CIN 0xE = Pitch Bend
}


void midi_pressure(uint8_t note, uint8_t pressure) {
    send_usb_midi_packet(0xA, 0xA0, note, pressure);  // CIN 0xA = Poly Pressure
}
