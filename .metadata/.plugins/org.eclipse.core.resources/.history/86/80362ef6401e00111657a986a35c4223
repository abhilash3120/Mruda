  HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
  __HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_1, 0);
  // Channel 2: Delayed by 'shift' counts
  //__HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_2, 20);



  HAL_TIM_Base_Start(&htim3);
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_4);

  __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_4, ADC_Offset);
  __HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_2, 27);

  HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_dma_buffer, 16);

  DWT_Delay_Init();

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  //HAL_I2S_Transmit_DMA(&hi2s2, (uint16_t*)sine_wave, TABLE_SIZE);
   HAL_I2S_Transmit_DMA(&hi2s2, (uint16_t*)buffer0, BUFFER_SIZE);
   mux_sel=5;
   set_mux(mux_sel);
   // calibrate data
  HAL_Delay(50);


  for(int j=0;j<10;j++)
  {
 	 for(int i = 0; i < 16; i++){
 		 set_mux(i);HAL_Delay(2);
 		 touch_cal[i]	 =touch_cal[i]+ adc_val[2];
 		 touch_cal[i+16] =touch_cal[i+16]+ adc_val[1];
 		 touch_cal[i+32] =touch_cal[i+32]+ adc_val[0];
 	 }
  }


  for(int i = 0; i < 48; i++){
 	 touch_cal[i]= round(touch_cal[i]/10);
  }



  HAL_Delay(50);
  TM1637_SetColon(0);
  TM1637_DisplayString("PLAY");

  drone_pa_freq=440.0f * powf(1.0594630f, (drone_sa_key - 48));
  drone_sa_freq=440.0f * powf(1.0594630f, (drone_pa_key - 48));

  PHASE_INC[3] =phase_v * drone_sa_freq;
  PHASE_INC[4] =phase_v * drone_pa_freq;
  reverb_val1=reverb_val[reverb_user_ind];
  reverb_val2=1-reverb_val1;

   uint32_t last_count = __HAL_TIM_GET_COUNTER(&htim3);



  while (1)
  {

	    uint32_t now = __HAL_TIM_GET_COUNTER(&htim3);


	    if ((now - last_count) >= 330)
	    {

	        last_count = now;
	        main_time_COUNTER++;


				  touch_p2[mux_sel]    = touch_p1[mux_sel];
				  touch_p2[mux_sel+16] = touch_p1[mux_sel+16];
				  touch_p2[mux_sel+32] = touch_p1[mux_sel+32];

				  touch_p1[mux_sel]    = touch_p[mux_sel];
				  touch_p1[mux_sel+16] = touch_p[mux_sel+16];
				  touch_p1[mux_sel+32] = touch_p[mux_sel+32];

	        		//meaure
	        	  touch[mux_sel] =  0.25f*(adc_val[2]+adc_val[6]+adc_val[10]+adc_val[14]);
	        	  touch[mux_sel+16]=0.25f*(adc_val[1]+adc_val[5]+adc_val[9]+adc_val[13]);
	        	  touch[mux_sel+32]=0.25f*(adc_val[0]+adc_val[4]+adc_val[8]+adc_val[12]);

	        	  touch_p[mux_sel]    = touch[mux_sel] - touch_cal[mux_sel];
	        	  touch_p[mux_sel+16] = touch[mux_sel+16] - touch_cal[mux_sel+16];
	        	  touch_p[mux_sel+32] = touch[mux_sel+32] - touch_cal[mux_sel+32];


	        	  if(mux_sel==15){
	        	        mux_dir = -1;
	        	  }
	        	  else if (mux_sel == 0)
	        	    {
	        	        mux_dir = +1;   // forward again
	        	    }

	        	  mux_sel += mux_dir;
	        	  set_mux(mux_sel);

	        	  if(mux_sel==15 || mux_sel==0){
		        	  //touch detect and tracj after comple scan
		        		  touch_estimate();
		        		  vol_knob=(float)adc_val[3];
		        		  vol_knob=vol_knob/4095;
		        		  p_volume= 0.00035*vol_knob;
			        	  set_freq();
			        	  dt=t2-t1;
	        	  }


	        	  if(main_time_COUNTER>1){
	        		  main_time_COUNTER=0;


//	        	  //function key
	        	  if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_9) == 0) { // Button pressed
	        	      function_t++;
	        	      if (function_t == 300) {  // Held for 200ms = 500ms if loop runs every 2.5ms (or adjust if 1ms)
	        	          function_flag = 1;   // Set flag once
	        	          TM1637_SetColon(0);
	        	          TM1637_DisplayString("FUNC");
	        	      }
	        	  } else {
	        	      function_t = 0; // Reset counter on release

					  if(function_flag == 1){
						  TM1637_SetColon(0);
						  TM1637_DisplayString("PLAY");}
					  function_flag = 0;
	        	      // Do NOT reset function_flag here if you want it to stay ON
	        	  }



	        	  //run functions
	        	  if(function_flag){
	        		  fn_max = 0;
	        		  for(int i = 0; i<3;i++){
	        			  if(fn_max < fn_touch[i]){
	        				  fn_max = fn_touch[i];
	        				  fn_index = (int)fn_ind[i];
	        			  }
	        		  }

	        			function_debug = fn_index;
	        			function_set();
	        	  }



	        	  if(drone_flag==1){
					  drone_t++;
					  if(drone_t>4000){drone_t=0;}
					  if(drone_t>0 && drone_t<480){drone_sa=1;drone_pa=0;}	  if(drone_t==480){drone_sa=0;drone_pa=0;}
					  if(drone_t>800 && drone_t<1280){drone_sa=0;drone_pa=1;}if(drone_t==1280){drone_sa=0;drone_pa=0;}
					  if(drone_t>1600 && drone_t<2000){drone_sa=0;drone_pa=1;}if(drone_t==2000){drone_sa=0;drone_pa=0;}
					  if(drone_t>2400 && drone_t<3320){drone_sa=1;drone_pa=0;}if(drone_t==3320){drone_sa=0;drone_pa=0;}
					  drone_sa=drone_sa*drone_vol*2;
					  drone_pa=drone_pa*drone_vol*2;

					  vol[3]=drone_sa;
					  vol[4]=drone_pa;
	        	  }

	        	  else{
	        		  vol[3]=0;
	        		  vol[4]=0;
	        	  }
	         }
	    }


    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

