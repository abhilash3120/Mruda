/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
	SCB->VTOR = 0x08010000;
	__enable_irq();

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  	//update_all_presets();
  	set_defaults();
	Creat_sine_table(sine_data,0);
	Creat_sine_table(sine_data_tanpura,5);

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_I2S2_Init();
  MX_TIM2_Init();
  MX_TIM3_Init();
  MX_TIM4_Init();
  MX_USB_DEVICE_Init();
  /* USER CODE BEGIN 2 */

  //these is to set the timer to set tjhe dac and excitation signal


  HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_2);
  HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);
  __HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_1, 0);

  HAL_TIM_Base_Start(&htim3);
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_4);


  __HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_2, 15); // phase shift for reference



  TM1637_Init();
  HAL_Delay(50);
  HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_dma_buffer, ADC_DMA_LEN);
  HAL_Delay(50);
  key_cal();



  HAL_I2S_Transmit_DMA(&hi2s2, (uint16_t*)Buffer, BUFFER_SIZE);
  DWT_Delay_Init();

  mode = Onboard;
  if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_9) == 0) {
	  mode = Edit;
	  enter_edit_mode();
  }





  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  static uint32_t last_count;
  while(1)
  {
	  uint32_t now = __HAL_TIM_GET_COUNTER(&htim3);
	  if ((now - last_count) >= 250) // loop of 250ms to run continously
	  {
	        last_count = now;
	        get_touch_position();
	        pos_measure_f_cal();
	        Tanpura();
	        function_process();
	  }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

