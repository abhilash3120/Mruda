#include "tm1637.h"

#define VALID_MAGIC            0xDEADBEEF
#define FLASH_USER_START_ADDR  0x08060000
#define FLASH_SECTOR_TO_USE    FLASH_SECTOR_7
#define DATA_SIZE_BYTES        96  // Keep it a multiple of 4
uint8_t flash_data[DATA_SIZE_BYTES];


void Flash_SaveData(uint8_t *data) {
    FLASH_EraseInitTypeDef EraseInit;
    uint32_t SectorError;

    HAL_FLASH_Unlock();

    EraseInit.TypeErase    = FLASH_TYPEERASE_SECTORS;
    EraseInit.Sector       = FLASH_SECTOR_TO_USE;
    EraseInit.NbSectors    = 1;
    EraseInit.VoltageRange = FLASH_VOLTAGE_RANGE_3;

    // 1. Erase and check status
    if (HAL_FLASHEx_Erase(&EraseInit, &SectorError) != HAL_OK) {
        HAL_FLASH_Lock();
        return;
    }

    uint32_t address = FLASH_USER_START_ADDR;

    // 2. Program Data
    for (int i = 0; i < DATA_SIZE_BYTES; i += 4) {
        uint32_t word;
        memcpy(&word, &data[i], 4);

        if (HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, address, word) != HAL_OK) {
            HAL_FLASH_Lock();
            return;
        }
        address += 4;
    }

    // 3. Program Magic Number right after the data
    HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, address, VALID_MAGIC);
    HAL_FLASH_Lock();
}


int Flash_LoadData(uint8_t *data) {
    uint32_t *flashPtr = (uint32_t*)FLASH_USER_START_ADDR;

    // The magic number is located after the data.
    // Index = DATA_SIZE_BYTES / 4
    uint32_t magicIndex = DATA_SIZE_BYTES / 4;

    if (flashPtr[magicIndex] != VALID_MAGIC) {
        return 0; // Magic number mismatch or empty flash
    }

    // Load the full 96 bytes
    memcpy(data, (uint8_t*)FLASH_USER_START_ADDR, DATA_SIZE_BYTES);

    return 1;
}


void send_flash_to_pc(){
	Flash_LoadData(flash_data);
    //USBD_HID_SendReport(&hUsbDeviceFS, flash_data,64);
}



void enter_edit_mode(){
	TM1637_SetColon(0);
	TM1637_DisplayString("EdIt");
	send_flash_to_pc();

	while(1 == 1){
		//USBD_HID_SendReport(&hUsbDeviceFS, flash_data,96);
		HAL_Delay(600);
		TM1637_DisplayString("EdIt");
		HAL_Delay(400);
		TM1637_DisplayString("Conn");
	}
}











