#define VALID_MAGIC            0xDEADBEEF
#define FLASH_USER_START_ADDR  0x08060000
#define FLASH_SECTOR_TO_USE    FLASH_SECTOR_7


typedef struct {
    uint8_t defaults[32];
    uint8_t scale_data[3][26];       // Example: 25 floats = 100 bytes
    uint8_t presets[6][16];       // Example: 96 floats = 384 bytes
} DeviceSettings;

DeviceSettings my_device;
#define TOTAL_DATA_BYTES ((sizeof(DeviceSettings) + 3) & ~3)

#define SLOT_SIZE (TOTAL_DATA_BYTES + 4)
#define MAX_SLOTS 5

#include "stdint.h"
#define DFU_MAGIC 0xDEADBEEF

uint8_t flash_data[96];

void Flash_SaveData(void)
{
    int target_slot = -1;

    // 1. Find the first empty slot (where magic number space is 0xFFFFFFFF)
    for(int i = 0; i < MAX_SLOTS; i++)
    {
        uint32_t slot_address = FLASH_USER_START_ADDR + (i * SLOT_SIZE);
        uint32_t *magic_ptr = (uint32_t *)(slot_address + TOTAL_DATA_BYTES);

        if(*magic_ptr == 0xFFFFFFFF) {
            target_slot = i;
            break; // Found an empty slot! Stop searching.
        }
    }

    HAL_FLASH_Unlock();

    // 2. If no empty slots were found, we MUST erase the sector and start at 0
    if(target_slot == -1)
    {
        FLASH_EraseInitTypeDef EraseInit;
        uint32_t SectorError;

        EraseInit.TypeErase    = FLASH_TYPEERASE_SECTORS;
        EraseInit.Sector       = FLASH_SECTOR_TO_USE;
        EraseInit.NbSectors    = 1;
        EraseInit.VoltageRange = FLASH_VOLTAGE_RANGE_3;

        HAL_FLASHEx_Erase(&EraseInit, &SectorError);
        target_slot = 0; // Start over at the beginning
    }

    // 3. Write data to the target slot
    uint32_t address = FLASH_USER_START_ADDR + (target_slot * SLOT_SIZE);
    uint8_t *data_ptr = (uint8_t *)&my_device;

    for(int i = 0; i < TOTAL_DATA_BYTES; i += 4)
    {
        uint32_t word;
        memcpy(&word, &data_ptr[i], 4);
        HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, address, word);
        address += 4;
    }

    // 4. Write the Magic Word at the very end of the slot to lock it in
    HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, address, VALID_MAGIC);

    HAL_FLASH_Lock();
}


int Flash_LoadData(void)
{
    int active_slot = -1;

    for(int i = 0; i < MAX_SLOTS; i++)
    {
        uint32_t slot_address = FLASH_USER_START_ADDR + (i * SLOT_SIZE);
        uint32_t *magic_ptr = (uint32_t *)(slot_address + TOTAL_DATA_BYTES);

        if(*magic_ptr == VALID_MAGIC) {
            active_slot = i; // Keep updating until we find the LAST valid one
        }
    }

    if(active_slot == -1) {
        return 0; // No valid slots found. Flash is completely empty or corrupted.
    }

    uint32_t final_address = FLASH_USER_START_ADDR + (active_slot * SLOT_SIZE);
    memcpy(&my_device, (uint8_t *)final_address, TOTAL_DATA_BYTES);

    return 1;
}


uint8_t temp[96];
void init_preset_flash(){

	int k =0;
	for (int i = 0; i<6 ;i++){
		for(int j = 0; j<16;j++){
			temp[k++] = default_preset[i][j];
		}
	}
	HAL_Delay(1000);
	Flash_SaveData(temp);
}



void update_all_presets(){
	HAL_Delay(50);
	Flash_LoadData(flash_data);

	/*
	 * this part run only once after uploading the program
	 * as there is no data on the flash to be loaded for preset
	 * doing this eases the production by avoiding flash through appliction
	 */

	int sum= 0;
	for (int i =0 ;i <96; i++){
		sum =+flash_data[i]; // all entries are zero at while running at the first time
	}

	if (sum < 5){
		init_preset_flash();
	}


	int j =0;
	for(int slot= 0; slot<6; slot++){
		for(int val =0 ; val<16; val++){
			preset[slot][val] = (float)flash_data[j];
			j++;
		}
	}
	HAL_Delay(50);
}


