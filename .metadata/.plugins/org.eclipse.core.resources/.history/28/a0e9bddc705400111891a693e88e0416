void check_dfu_boot(void)
{
    if (dfu_flag == 0xDEADBEEF)
    {
        dfu_flag = 0;

        __disable_irq();

        HAL_RCC_DeInit();
        HAL_DeInit();

        SysTick->CTRL = 0;

        uint32_t sys_mem_addr = 0x1FFF0000; // STM32F4 (verify chip)

        void (*sys_mem_boot)(void);
        sys_mem_boot = (void (*)(void)) (*((uint32_t *)(sys_mem_addr + 4)));

        __set_MSP(*(uint32_t *)sys_mem_addr);

        sys_mem_boot();
    }
}


void enter_dfu_mode(void)
{
    dfu_flag = 0xDEADBEEF;
    NVIC_SystemReset();
}
