float auto_correct(int scale_index, float input) {


    int temp_oct = 0;
    ScaleDef active_scale = scale_library[scale_index];
    int len = active_scale.length;

    float nearest_note = 0.0f;     // Stores the actual note to return
    float min_dist = 100.0f;       // Tracks the shortest distance found

    // Fix 1: Properly subtract 12
    while (input >= 12.0f) {
            input -= 12.0f;
            temp_oct++;
        }

    // Fix 2 & 3: Use fabsf(a - b) and save the note, not the distance
    for (int i = 0; i < len; i++) {
        float temp_dist = fabsf(active_scale.notes[i] - input);

        if (temp_dist < min_dist) {
            min_dist = temp_dist;
            nearest_note = active_scale.notes[i];
        }
    }

    // Fix 4: The High Sa Wrap-Around check
    if (fabsf(12.0000f - input) < min_dist) {
        nearest_note = 12.0000f;
    }

    if (temp_oct >0) {
        nearest_note += temp_oct*12.0f;
    }

    return nearest_note;
}

static int demo_idx = -1;       // -1 means stopped
static uint8_t note_is_on = 0;
static uint32_t last_tick = 0;

void start_demo_scale(void) {
    demo_idx = 0;
    note_is_on = 0;
    last_tick = 0;
}

void handle_demo_scale(void) {
    if (demo_idx < 0 || (HAL_GetTick() - last_tick < 150)) return;

    last_tick = HAL_GetTick();
    int length = scale_library[set_para.AC_scale].length;

    if (note_is_on) {
        // Turn note OFF
        peak.flag[4] = 0;
        note_is_on = 0;
        demo_idx++; // Move to the next note index
    }
    else {
        // We now stop at 'length + 1' so we have room to play the Taar Shadja
        if (demo_idx > length) {
            demo_idx = -1; // Stop the demo
            return;
        }

        // --- PLAY THE NOTE ---
        if (demo_idx == length) {
            key.play[4] = scale_library[set_para.AC_scale].notes[4] + 12;
        }
        else {
            key.play[4] = scale_library[set_para.AC_scale].notes[demo_idx];
        }

        key.freq[4] = 440.0f * powf(1.0594630f, (key.play[4] - 48));
        key.phase[4] = PHASE_FACT * key.freq[4];

        key.vol[4] = 0.1f;
        note_is_on = 1;
    }
