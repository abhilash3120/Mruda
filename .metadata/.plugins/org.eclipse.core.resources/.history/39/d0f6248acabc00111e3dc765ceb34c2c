#define VALID_MAGIC            0xDEADBEEF
#define FLASH_USER_START_ADDR  0x08060000
#define FLASH_SECTOR_TO_USE    FLASH_SECTOR_7
//#define TOTAL_DATA_BYTES       96  // Must be a multiple of 4

#define TOTAL_DATA_BYTES       (((sizeof(default_raw_settings) + 3) / 4) * 4)



// 3. Automatically calculate the 4-byte padded size (189 becomes 192)
#define TOTAL_DATA_BYTES       (((sizeof(default_raw_settings) + 3) / 4) * 4)

#define VALID_MAGIC            0xDEADBEEF
#define FLASH_USER_START_ADDR  0x08060000
#define FLASH_SECTOR_TO_USE    FLASH_SECTOR_7


// ==========================================
// SAVE FUNCTION
// ==========================================
void Flash_SaveData(void)
{
    FLASH_EraseInitTypeDef EraseInit;
    uint32_t SectorError;

    HAL_FLASH_Unlock();

    // 1. Erase the Sector
    EraseInit.TypeErase    = FLASH_TYPEERASE_SECTORS;
    EraseInit.Sector       = FLASH_SECTOR_TO_USE;
    EraseInit.NbSectors    = 1;
    EraseInit.VoltageRange = FLASH_VOLTAGE_RANGE_3;

    HAL_FLASHEx_Erase(&EraseInit, &SectorError);

    uint32_t address = FLASH_USER_START_ADDR;
    uint8_t *data_ptr = (uint8_t *)&raw_flash_data;

    // 2. Write the Struct Data (in 4-byte chunks)
    for(int i = 0; i < TOTAL_DATA_BYTES; i += 4)
    {
        uint32_t word = 0xFFFFFFFF; // Start with erased flash state

        // Safely determine how many bytes are left to copy (protects against the 189-byte limit)
        int bytes_to_copy = sizeof(default_raw_settings) - i;
        if(bytes_to_copy > 4) {
            bytes_to_copy = 4;
        }

        // Copy up to 4 bytes into our 'word' variable
        if (bytes_to_copy > 0) {
            memcpy(&word, &data_ptr[i], bytes_to_copy);
        }

        // Write the 4-byte word to flash
        HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, address, word);
        address += 4;
    }

    // 3. Write the Magic Word at the very end
    HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, address, VALID_MAGIC);

    HAL_FLASH_Lock();
}

int Flash_LoadData(default_raw_settings *target_struct)
{
    // The magic word is located exactly after our padded data length
    uint32_t magic_address = FLASH_USER_START_ADDR + TOTAL_DATA_BYTES;
    uint32_t *magic_ptr = (uint32_t *)magic_address;

    // 1. Check if the magic word exists
    if(*magic_ptr != VALID_MAGIC) {
        return 0; // Magic number mismatch, flash is empty/corrupted
    }

    // 2. Found it! Copy the flash data directly into the struct you passed in
    memcpy(target_struct, (uint8_t *)FLASH_USER_START_ADDR, sizeof(default_raw_settings));

    return 1;
}




uint8_t flash_data[96];
void Flash_SaveData1(uint8_t *data)
{
    FLASH_EraseInitTypeDef EraseInit;
    uint32_t SectorError;
    HAL_FLASH_Unlock();

    EraseInit.TypeErase    = FLASH_TYPEERASE_SECTORS;
    EraseInit.Sector       = FLASH_SECTOR_TO_USE;
    EraseInit.NbSectors    = 1;
    EraseInit.VoltageRange = FLASH_VOLTAGE_RANGE_3;

    HAL_FLASHEx_Erase(&EraseInit, &SectorError);
    uint32_t address = FLASH_USER_START_ADDR;

    for(int i = 0; i < TOTAL_DATA_BYTES; i += 4)
    {
        uint32_t word;
        memcpy(&word, &data[i], 4);

        HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, address, word);
        address += 4;
    }

    HAL_FLASH_Program(FLASH_TYPEPROGRAM_WORD, address, VALID_MAGIC);
    HAL_FLASH_Lock();
}


int Flash_LoadData1(uint8_t *data)
{
    uint32_t *flashPtr = (uint32_t*)FLASH_USER_START_ADDR;

    uint32_t magicIndex = TOTAL_DATA_BYTES / 4;
    if(flashPtr[magicIndex] != VALID_MAGIC)
        return 0; // Magic number mismatch, flash is likely empty/uninitialized

    memcpy(data, (uint8_t*)FLASH_USER_START_ADDR, TOTAL_DATA_BYTES);
    return 1;
}


