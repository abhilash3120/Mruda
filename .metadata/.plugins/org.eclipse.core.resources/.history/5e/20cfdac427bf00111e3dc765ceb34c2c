void filter_vol(int ch){
	static float vol_old[5],vol_smooth_old[5];

	for(uint8_t j=0;j<ch;j++){
		key.vol[j]=0.2f*key.vol[j]+0.8f*vol_old[j];
		vol_old[j]=key.vol[j];

		float alpha = (key.vol[j] > key.vol_smooth[j]) ? 0.03f : 0.0005f;
		key.vol_smooth[j] += alpha * (key.vol[j] - key.vol_smooth[j]);
		if(key.vol_smooth[j] < 0.0001f)	key.vol_smooth[j] = 0.0f;
	}

	key.vol[3]=0.003f*key.vol[3]+0.997f*vol_old[3];
	vol_old[3]=key.vol[3];
	key.vol_smooth[3]=0.0001f*key.vol[3]+0.9999f*vol_smooth_old[3];
	vol_smooth_old[3]=key.vol_smooth[3];

	key.vol[4]=0.003f*key.vol[4]+0.997f*vol_old[4];
	vol_old[4]=key.vol[4];
	key.vol_smooth[4]=0.0001f*key.vol[4]+0.9999f*vol_smooth_old[4];
	vol_smooth_old[4]=key.vol_smooth[4];
}


float p[5];
float t_samp_rev;
float t_samp;

void buffer_gen(){

	   t_samp_rev=   key.vol_smooth[0]*sine(p[0])+
			   	   	 key.vol_smooth[1]*sine(p[1])+
					 key.vol_smooth[2]*sine(p[2]);

	   t_samp=		t_samp_rev+
			   	   	key.vol_smooth[3]*sine_t(p[3])+
					key.vol_smooth[4]*sine_t(p[4]);

     // Increment and wrap phase
     p[0] += key.phase[0];
			if (p[0] >= TWOPI)
				p[0] -= TWOPI;

     p[1] += key.phase[1];
         if (p[1] >= TWOPI)
         	p[1] -= TWOPI;

     p[2] += key.phase[2];
         if (p[2] >= TWOPI)
         	p[2] -= TWOPI;

     p[3] += key.phase[3];
         if (p[3] >= TWOPI)
             p[3] -= TWOPI;

     p[4] += key.phase[4];
         if (p[4] >= TWOPI)
             p[4] -= TWOPI;
}


void buffer_gen_mono(){
	filter_vol(1);
	   t_samp_rev=  key.vol_smooth[0]*sine(p[0]);

	   t_samp=		t_samp_rev+
			   	   	key.vol_smooth[3]*sine_t(p[3])+
					key.vol_smooth[4]*sine_t(p[4]);



     // Increment and wrap phase
     p[0] += key.phase[0];
     while  (p[0] >= TWOPI)
				p[0] -= TWOPI;


     p[3] += key.phase[3];
     while  (p[3] >= TWOPI)
             p[3] -= TWOPI;

     p[4] += key.phase[4];
     while  (p[4] >= TWOPI)
             p[4] -= TWOPI;
}


// 1. The Jezar Tuning Delay Times (Perfectly tuned for 32kHz)
#define C1_DEL 1116
#define C2_DEL 1188
#define C3_DEL 1277
#define C4_DEL 1356
#define C5_DEL 1422
#define C6_DEL 1491
#define C7_DEL 1557
#define C8_DEL 1617

// 2. The Buffer Sizes (Padded with extra space for the LFO to move safely)
#define C1_BUF (C1_DEL + 32)
#define C2_BUF (C2_DEL + 32)
#define C3_BUF (C3_DEL + 32)
#define C4_BUF (C4_DEL + 32)
#define C5_BUF (C5_DEL + 32)
#define C6_BUF (C6_DEL + 32)
#define C7_BUF (C7_DEL + 32)
#define C8_BUF (C8_DEL + 32)

// 3. All-Pass Filters (No LFO here, so Buffer = Delay)
#define AP1_BUF 556
#define AP2_BUF 441
#define AP3_BUF 341
#define AP4_BUF 225

// 4. Memory Allocation
static float comb1[C1_BUF], comb2[C2_BUF], comb3[C3_BUF], comb4[C4_BUF];
static float comb5[C5_BUF], comb6[C6_BUF], comb7[C7_BUF], comb8[C8_BUF];
static float ap_buf1[AP1_BUF], ap_buf2[AP2_BUF], ap_buf3[AP3_BUF], ap_buf4[AP4_BUF];


void init_reverb(void) {
    for (int i = 0; i < C1_BUF; i++) comb1[i] = 0.0f;
    for (int i = 0; i < C2_BUF; i++) comb2[i] = 0.0f;
    for (int i = 0; i < C3_BUF; i++) comb3[i] = 0.0f;
    for (int i = 0; i < C4_BUF; i++) comb4[i] = 0.0f;
    for (int i = 0; i < C5_BUF; i++) comb5[i] = 0.0f;
    for (int i = 0; i < C6_BUF; i++) comb6[i] = 0.0f;
    for (int i = 0; i < C7_BUF; i++) comb7[i] = 0.0f;
    for (int i = 0; i < C8_BUF; i++) comb8[i] = 0.0f;

    for (int i = 0; i < AP1_BUF; i++) ap_buf1[i] = 0.0f;
    for (int i = 0; i < AP2_BUF; i++) ap_buf2[i] = 0.0f;
    for (int i = 0; i < AP3_BUF; i++) ap_buf3[i] = 0.0f;
    for (int i = 0; i < AP4_BUF; i++) ap_buf4[i] = 0.0f;
}


float reverb_gen() {
    // Reverb Parameters
    float rev_mix_level = 0.6f;
    float REV_FEEDBACK = 0.94f;
    float REV_DAMP = 0.20f;

    // Fast static pointers
    static int c_idx[8] = {0};
    static int ap_idx[4] = {0};
    static float damp[8] = {0.0f};

    // --- THE CHORUS LFO ---
    static int lfo_val = 0;
    static int lfo_dir = 1;
    static int lfo_tick = 0;

    // Move the LFO up and down by 1 every 48 samples
    if (++lfo_tick >= 48) {
        lfo_tick = 0;
        lfo_val += lfo_dir;
        // Sweep between -6 and +6 samples
        if (lfo_val >= 6) lfo_dir = -1;
        else if (lfo_val <= -6) lfo_dir = 1;
    }

    // Stagger the modulation
    int mod1 = 0;
    int mod2 = 0;
    int mod3 = 0;
    int mod4 = 0;

    // CRASH PROTECTION: Anti-Denormal Offset
    float input_sample = (float)t_samp_rev + 1e-6f;

    // 1. The 8 Parallel Comb Filters
    float comb_sum = 0.0f;
    int r;

    // Comb 1 (Modulated)
    r = c_idx[0] - (C1_DEL + mod1);
    while (r < 0) r += C1_BUF;
    float c_out1 = comb1[r];
    damp[0] = (c_out1 * (1.0f - REV_DAMP)) + (damp[0] * REV_DAMP);
    comb1[c_idx[0]] = input_sample + (damp[0] * REV_FEEDBACK);
    if (++c_idx[0] >= C1_BUF) c_idx[0] = 0;
    comb_sum += c_out1;

    // Comb 2 (Modulated)
    r = c_idx[1] - (C2_DEL + mod2);
    while (r < 0) r += C2_BUF;
    float c_out2 = comb2[r];
    damp[1] = (c_out2 * (1.0f - REV_DAMP)) + (damp[1] * REV_DAMP);
    comb2[c_idx[1]] = input_sample + (damp[1] * REV_FEEDBACK);
    if (++c_idx[1] >= C2_BUF) c_idx[1] = 0;
    comb_sum += c_out2;

    // Comb 3 (Modulated)
    r = c_idx[2] - (C3_DEL + mod3);
    while (r < 0) r += C3_BUF;
    float c_out3 = comb3[r];
    damp[2] = (c_out3 * (1.0f - REV_DAMP)) + (damp[2] * REV_DAMP);
    comb3[c_idx[2]] = input_sample + (damp[2] * REV_FEEDBACK);
    if (++c_idx[2] >= C3_BUF) c_idx[2] = 0;
    comb_sum += c_out3;

    // Comb 4 (Modulated)
    r = c_idx[3] - (C4_DEL + mod4);
    while (r < 0) r += C4_BUF;
    float c_out4 = comb4[r];
    damp[3] = (c_out4 * (1.0f - REV_DAMP)) + (damp[3] * REV_DAMP);
    comb4[c_idx[3]] = input_sample + (damp[3] * REV_FEEDBACK);
    if (++c_idx[3] >= C4_BUF) c_idx[3] = 0;
    comb_sum += c_out4;

    // Comb 5 (Static Core)
    r = c_idx[4] - C5_DEL;
    while (r < 0) r += C5_BUF;
    float c_out5 = comb5[r];
    damp[4] = (c_out5 * (1.0f - REV_DAMP)) + (damp[4] * REV_DAMP);
    comb5[c_idx[4]] = input_sample + (damp[4] * REV_FEEDBACK);
    if (++c_idx[4] >= C5_BUF) c_idx[4] = 0;
    comb_sum += c_out5;

    // Comb 6 (Static Core)
    r = c_idx[5] - C6_DEL;
    while (r < 0) r += C6_BUF;
    float c_out6 = comb6[r];
    damp[5] = (c_out6 * (1.0f - REV_DAMP)) + (damp[5] * REV_DAMP);
    comb6[c_idx[5]] = input_sample + (damp[5] * REV_FEEDBACK);
    if (++c_idx[5] >= C6_BUF) c_idx[5] = 0;
    comb_sum += c_out6;

    // Comb 7 (Static Core)
    r = c_idx[6] - C7_DEL;
    while (r < 0) r += C7_BUF;
    float c_out7 = comb7[r];
    damp[6] = (c_out7 * (1.0f - REV_DAMP)) + (damp[6] * REV_DAMP);
    comb7[c_idx[6]] = input_sample + (damp[6] * REV_FEEDBACK);
    if (++c_idx[6] >= C7_BUF) c_idx[6] = 0;
    comb_sum += c_out7;

    // Comb 8 (Static Core)
    r = c_idx[7] - C8_DEL;
    while (r < 0) r += C8_BUF;
    float c_out8 = comb8[r];
    damp[7] = (c_out8 * (1.0f - REV_DAMP)) + (damp[7] * REV_DAMP);
    comb8[c_idx[7]] = input_sample + (damp[7] * REV_FEEDBACK);
    if (++c_idx[7] >= C8_BUF) c_idx[7] = 0;
    comb_sum += c_out8;

    // Scale down the sum of 8 filters (comb_sum / 8)
    comb_sum *= 0.125f;

    // 2. The 4 Series All-Pass Filters (Diffusers)
    float ap_v, ap_del;

    ap_del = ap_buf1[ap_idx[0]];
    ap_v = comb_sum + (0.5f * ap_del);
    float ap1_out = -0.5f * ap_v + ap_del;
    ap_buf1[ap_idx[0]] = ap_v;
    if (++ap_idx[0] >= AP1_BUF) ap_idx[0] = 0;

    ap_del = ap_buf2[ap_idx[1]];
    ap_v = ap1_out + (0.5f * ap_del);
    float ap2_out = -0.5f * ap_v + ap_del;
    ap_buf2[ap_idx[1]] = ap_v;
    if (++ap_idx[1] >= AP2_BUF) ap_idx[1] = 0;

    ap_del = ap_buf3[ap_idx[2]];
    ap_v = ap2_out + (0.5f * ap_del);
    float ap3_out = -0.5f * ap_v + ap_del;
    ap_buf3[ap_idx[2]] = ap_v;
    if (++ap_idx[2] >= AP3_BUF) ap_idx[2] = 0;

    ap_del = ap_buf4[ap_idx[3]];
    ap_v = ap3_out + (0.5f * ap_del);
    float rev_sample = -0.5f * ap_v + ap_del;
    ap_buf4[ap_idx[3]] = ap_v;
    if (++ap_idx[3] >= AP4_BUF) ap_idx[3] = 0;

    // 3. Dry/Wet Mix
    float final_out = (1.0f - rev_mix_level) * t_samp + (rev_mix_level) * rev_sample;

    // Remove the safety offset
    final_out -= 1e-6f;

    // 4. Hard Clipping
    if (final_out > 32000.0f) final_out = 32000.0f;
    else if (final_out < -32000.0f) final_out = -32000.0f;

    t_samp = final_out;
    return final_out;
}


